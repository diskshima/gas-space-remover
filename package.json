  "devDependencies": {
    "@types/google-apps-script": "2.0.8",
    "cpx": "^1.5.0",
    "gas-webpack-plugin": "^2.6.0",
    "merge": ">=2.1.1",
    "prettier": "^2.8.8",
    "randomatic": ">=3.1.1",
    "rimraf": "^6.1.3",
    "ts-loader": "^9.5.4",
    "tslint": "^6.1.3",
    "tslint-config-prettier": "^1.18.0",
